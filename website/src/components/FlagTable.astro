---
// A table of CLI flags for the reference page. Descriptions may use `backticks` for code.
export interface Flag {
  flag: string;
  short?: string;
  arg?: string;
  default?: string;
  repeatable?: boolean;
  description: string;
}

interface Props {
  flags: Flag[];
}

const { flags } = Astro.props;

/** Split "use `json` here" into text and code runs. */
const runs = (text: string) =>
  text.split("`").map((part, index) => ({ code: index % 2 === 1, part }));
---

<div class="ns-table">
  <table>
    <thead>
      <tr>
        <th scope="col" style="width: 40%">Flag</th>
        <th scope="col" style="width: 17%">Default</th>
        <th scope="col">Description</th>
      </tr>
    </thead>
    <tbody>
      {
        flags.map((row) => (
          <tr>
            <td>
              {row.short && <code class="ns-short">{row.short}</code>}
              <code class="ns-flag">{row.flag}</code>
              {row.arg && <code class="ns-arg"> {row.arg}</code>}
              {row.repeatable && <span class="ns-tag">repeatable</span>}
            </td>
            <td>{row.default ? <code>{row.default}</code> : <span class="ns-none">None</span>}</td>
            <td>{runs(row.description).map(({ code, part }) => (code ? <code>{part}</code> : part))}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .ns-table td code {
    padding: 0;
    background: none;
  }
  .ns-flag {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .ns-arg {
    color: var(--sl-color-gray-3);
  }
  .ns-short {
    margin-inline-end: 0.375rem;
    padding: 0 0.3125rem !important;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
  }
  .ns-tag {
    display: inline-block;
    margin-inline-start: 0.5rem;
    padding: 0 0.4375rem;
    border: 1px solid var(--ns-page-line);
    border-radius: 999px;
    background-color: var(--ns-page-bg);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--ns-page-ink);
    white-space: nowrap;
  }
  .ns-none {
    color: var(--sl-color-gray-3);
  }
</style>
