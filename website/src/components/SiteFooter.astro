---
// The site footer: what the project is, three columns of links, and a bottom row with the
// copyright and licence on the left and the licence file and the netspeedy organisation on the
// right. The project's own copy comes from src/lib/site.ts.
import { github, icons } from "../lib/icons";
import { footerColumns, links, product } from "../lib/site";
import Mark from "./Mark.astro";
---

<div class="ns-site-footer not-content">
  <div class="ns-columns">
    <div class="ns-about">
      <p class="ns-name"><Mark size={22} />{product.name}</p>
      <p>{product.description}</p>
    </div>
    {
      footerColumns.map(({ title, items }) => (
        <nav aria-label={title}>
          <h2>{title}</h2>
          <ul>
            {items.map(({ label, href }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="ns-base">
    <p class="ns-legal">
      <Mark size={18} />
      <span>© 2026 <b>Simon Oakes</b>. Released under the MIT License.</span>
    </p>
    <div class="ns-base-links">
      <a href={`${links.repo}/blob/main/LICENSE`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.scale} />
        Licence
      </a>
      <a href={links.org} aria-label="netspeedy on GitHub">
        <svg class="ns-github" viewBox="0 0 16 16" aria-hidden="true"><path d={github} /></svg>
        GitHub
      </a>
    </div>
  </div>
</div>

<style>
  .ns-site-footer {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
    font-size: var(--sl-text-sm);
  }
  .ns-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }
  .ns-name {
    display: flex;
    align-items: center;
    gap: 0.5625rem;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .ns-about p + p {
    max-width: 17.5rem;
    margin: 0.625rem 0 0;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }
  h2 {
    margin: 0.125rem 0 0.625rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: inherit;
    letter-spacing: normal;
    color: var(--sl-color-white);
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  li a {
    display: inline-block;
    padding-block: 0.1875rem;
  }

  .ns-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
    margin-top: 2rem;
    padding: 1.125rem 0 0.5rem;
    border-top: 1px solid var(--sl-color-hairline-shade);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .ns-legal {
    --ns-mark: var(--sl-color-gray-3);
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0;
  }
  .ns-legal b {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .ns-base-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.125rem;
    margin-inline-start: auto;
  }
  .ns-base-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding-block: 0.25rem;
  }
  svg {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ns-github {
    fill: currentColor;
    stroke: none;
  }

  @media (max-width: 40rem) {
    .ns-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ns-about {
      grid-column: 1 / -1;
    }
    .ns-legal {
      align-items: flex-start;
    }
    .ns-legal :global(.ns-mark) {
      margin-top: 1px;
    }
    .ns-base-links {
      margin-inline-start: 0;
    }
  }
</style>
