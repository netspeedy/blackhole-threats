---
// Every sidebar group and its pages, as a card each, for the home page. It's built from the
// sidebar, so it can't fall out of step with it.
import { directory } from "../lib/sections";
import { directorySubtitle } from "../lib/site";
import SectionIcon from "./SectionIcon.astro";

const groups = directory(Astro.locals.fullSidebar);
---

<section class="ns-directory not-content" aria-labelledby="browse-the-docs">
  <h2 id="browse-the-docs">Browse the docs</h2>
  <p class="ns-directory-sub">{directorySubtitle}</p>
  <div class="ns-cards">
    {
      groups.map(({ section, links }) => (
        <section class="ns-card" style={`--cl: var(--ns-${section.hue}-line)`}>
          <SectionIcon section={section} large />
          <h3>{section.label}</h3>
          <p>{section.blurb}</p>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>

<style>
  h2 {
    margin: 0 0 0.375rem;
    font-size: 1.375rem;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
  }
  .ns-directory-sub {
    margin: 0 0 1.5rem;
    color: var(--sl-color-gray-3);
  }
  .ns-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .ns-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 0.875rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 14px;
    background-color: var(--sl-color-gray-7);
  }
  .ns-card:hover {
    border-color: var(--cl);
  }
  h3 {
    margin: 1rem 0 0;
    font-size: var(--sl-text-base);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .ns-card p {
    min-height: 3em;
    margin: 0.25rem 0 0.875rem;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0.625rem 0 0;
    border-top: 1px solid var(--sl-color-hairline-shade);
    list-style: none;
  }
  a {
    display: block;
    padding-block: 0.3125rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }

  @media (max-width: 64rem) {
    .ns-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 36rem) {
    .ns-cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .ns-card p {
      min-height: 0;
    }
  }
</style>
